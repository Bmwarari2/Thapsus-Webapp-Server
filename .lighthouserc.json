{
  "ci": {
    "collect": {
      "staticDistDir": "./client/dist",
      "url": ["http://localhost/"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2"
        ],
        "chromeFlags": "--force-prefers-color-scheme=light"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
