# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
# REQUIRED: set to a long, random string in production
JWT_SECRET=CHANGE_ME_SECURE_RANDOM
JWT_EXPIRY=7d

# ─────────────────────────────────────────────────────────────
# Supabase / PostgreSQL Database
# Get this from: Supabase Dashboard → Project Settings → Database
# Use the DIRECT connection (port 5432) — the pooler on 6543 blocks DDL,
# which the migration runner needs.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Opt-in: run pending migrations at boot (default off; prefer `npm run migrate`)
RUN_MIGRATIONS_ON_BOOT=false

# Supabase (Storage signed URLs + client Realtime under RLS)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# CORS (comma-separated allowlist; '*' only honoured in development)
CORS_ORIGIN=http://localhost:5173

# Public site URL (used by sitemap.xml & robots.txt — omit trailing slash)
SITE_URL=https://thapsus.uk

# Admin Settings
ADMIN_EMAIL=admin@thapsus.uk
# REQUIRED: strong admin password for initial bootstrap only
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────────────────────────────────────────────────────────────
# M-Pesa via Lipana (lipana.dev) STK Push
# ─────────────────────────────────────────────────────────────
MPESA_PROVIDER=lipana
LIPANA_API_KEY=your_lipana_api_key
LIPANA_WEBHOOK_SECRET=your_lipana_webhook_secret
# Legacy manual fallback (paste-the-SMS flow)
MPESA_TILL_NUMBER=5530500

# ─────────────────────────────────────────────────────────────
# sent.dm — WhatsApp Business messaging (primary customer channel)
# API key from the sent.dm console (sk_live_* / sk_test_*).
# The webhook signing secret (whsec_*) is returned when the webhook is
# created — POST /v3/webhooks or the console.
# ─────────────────────────────────────────────────────────────
SENTDM_API_KEY=sk_test_your_sentdm_api_key
SENTDM_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Optional override; defaults to https://api.sent.dm
SENTDM_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Gmail API (OAuth2) — operator password-reset emails
# 1. Go to https://console.cloud.google.com → Create/select project
# 2. Enable the Gmail API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Add https://developers.google.com/oauthplayground as redirect URI
# 5. Go to https://developers.google.com/oauthplayground
#    - Click ⚙️ → Check "Use your own OAuth credentials" → enter client ID & secret
#    - Select "Gmail API v1" → "https://mail.google.com/" scope
#    - Authorize & exchange for refresh token
# ─────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=your_google_oauth2_client_id
GMAIL_CLIENT_SECRET=your_google_oauth2_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth2_refresh_token
GMAIL_SENDER_EMAIL=noreply@thapsus.uk

# Footer / support contact surfaced via /api/app-config
APP_SUPPORT_WHATSAPP=+254700000000
SUPPORT_EMAIL=support@thapsus.uk

# Client build-time analytics (optional)
VITE_GTM_ID=
