# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
# REQUIRED: set to a long, random string in production
JWT_SECRET=CHANGE_ME_SECURE_RANDOM
JWT_EXPIRY=7d

# ─────────────────────────────────────────────────────────────
# Supabase / PostgreSQL Database
# Get this from: Supabase Dashboard → Project Settings → Database
# Use the "Connection string" (URI format) — Transaction pooler recommended for Railway
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# CORS
CORS_ORIGIN=http://localhost:3000

# Public site URL (used by sitemap.xml & robots.txt — omit trailing slash)
SITE_URL=https://thapsus.uk

# ─────────────────────────────────────────────────────────────
# Influencer link analytics (migration 0003) — all OPTIONAL
# ─────────────────────────────────────────────────────────────
# Salt for hashing visitor IPs before storage (unique-visitor counts only;
# the raw IP is never persisted). Defaults to JWT_SECRET when unset.
IP_HASH_SECRET=CHANGE_ME_SECURE_RANDOM
# Timeout (ms) for the best-effort ipwho.is geolocation lookup; failures/timeouts
# silently yield "no location" and never block a request.
GEO_LOOKUP_TIMEOUT_MS=2000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=123456
MPESA_BUSINESS_TYPE=4

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ─────────────────────────────────────────────────────────────
# Gmail API (OAuth2) — Used for sending all transactional emails
# 1. Go to https://console.cloud.google.com → Create/select project
# 2. Enable the Gmail API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Add https://developers.google.com/oauthplayground as redirect URI
# 5. Go to https://developers.google.com/oauthplayground
#    - Click ⚙️ → Check "Use your own OAuth credentials" → enter client ID & secret
#    - Select "Gmail API v1" → "https://mail.google.com/" scope
#    - Authorize & exchange for refresh token
# ─────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=your_google_oauth2_client_id
GMAIL_CLIENT_SECRET=your_google_oauth2_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth2_refresh_token
GMAIL_SENDER_EMAIL=noreply@thapsus.uk

# Africa's Talking Configuration
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=thapsuscargo
AFRICASTALKING_SENDER_ID=Thapsus Cargo

# WhatsApp Configuration
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Admin Settings
ADMIN_EMAIL=admin@thapsus.uk
# REQUIRED: strong admin password for initial bootstrap only
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Warehouse Addresses
# Override these to update warehouse addresses without redeploying.
# All lines are optional — sensible defaults are used if omitted.
WAREHOUSE_UK_LINE1=31 Collingwood Close
WAREHOUSE_UK_LINE2=Hazel Grove, Stockport
WAREHOUSE_UK_LINE3=SK7 4LB
WAREHOUSE_UK_LINE4=United Kingdom
WAREHOUSE_CHINA_LINE1=Thapsus Cargo Warehouse
WAREHOUSE_CHINA_LINE2=Shanghai, China

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_WHATSAPP_NOTIFICATIONS=true

# Exchange Rate API (optional)
EXCHANGERATE_API_KEY=your_exchangerate_api_key

# Logging
LOG_LEVEL=info

# ── Web Push (PWA notifications) ──────────────────────────────────────────────
# Generate a keypair once with:  npx web-push generate-vapid-keys
# Then set all three. Without them, web push silently no-ops (app still runs).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@thapsus.uk
